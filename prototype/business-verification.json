{
  "version": "2026-11-02 / Cyrillic business alignment",
  "scope": "Local design prototype, not a live backend integration test",
  "checks": [
    {
      "name": "Lead conversion creates a student and optional enrollment through the form",
      "passed": true
    },
    {
      "name": "Conversion retries reuse the same student; matching phone reuses an existing profile",
      "passed": true
    },
    {
      "name": "Multiple group enrollment preserves prior groups and custom price",
      "passed": true
    },
    {
      "name": "Capacity blocks enrollment; frozen and departed enrollments can be reactivated",
      "passed": true
    },
    {
      "name": "Lost stage requires an explicit reason form and keeps the lead separate from enrollment",
      "passed": true
    },
    {
      "name": "Payment form keeps six methods, cash account, group, billing period and decimal amount",
      "passed": true
    },
    {
      "name": "Payment operation retry cannot double credit and conflicts on changed payload",
      "passed": true
    },
    {
      "name": "Expenses require account and category and debit the chosen balance",
      "passed": true
    },
    {
      "name": "All four billing modes preview correctly; trial/freeze excluded and retry creates no duplicate charges",
      "passed": true
    },
    {
      "name": "Per-lesson billing charges unexcused absence but skips excused and uncompleted lessons",
      "passed": true
    },
    {
      "name": "Salary supports group overrides, paid billing period and fixed monthly salary counted once",
      "passed": true
    },
    {
      "name": "Salary approval and full payout create one expense and prohibit a second payment",
      "passed": true
    },
    {
      "name": "Teacher and cashier roles match seeded permission defaults and guard UI actions",
      "passed": true
    },
    {
      "name": "Attendance is group/date specific; future lesson cannot be marked and coin rewards save separately",
      "passed": true
    },
    {
      "name": "SMS submits one recipient with Pending status and stable operation ID; no Accepted status",
      "passed": true
    },
    {
      "name": "Reward purchase debits coins and stock once; insufficient balance rejects purchase",
      "passed": true
    },
    {
      "name": "New staff requires hire date, role type and a 12-character initial password",
      "passed": true
    },
    {
      "name": "New lead stays visible in its branch and group room options follow the selected branch",
      "passed": true
    },
    {
      "name": "Branch switch filters group/student views and report period changes the derived totals",
      "passed": true
    },
    {
      "name": "Permission keys match backend constants; original green and white tokens retained",
      "passed": true
    },
    {
      "name": "Attendance automatically grants/reverses five coins only when Present changes; frozen students excluded",
      "passed": true
    },
    {
      "name": "Schedule generation counts existing lessons, retries without duplicates and rejects an impossible end date atomically",
      "passed": true
    },
    {
      "name": "Signed manual coin adjustment is idempotent and cannot create a negative balance",
      "passed": true
    },
    {
      "name": "Unfreezing preserves group enrollment and restores debt status from the balance",
      "passed": true
    },
    {
      "name": "All sixteen preview states open and native English month labels are replaced by ISO periods",
      "passed": true
    },
    {
      "name": "All pages render in Cyrillic with no unexpected English interface text",
      "passed": true
    },
    {
      "name": "Responsive layout keeps document inside viewport on all 22 pages",
      "passed": true
    }
